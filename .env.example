# Copy to .env and replace every "change-me" value. NEVER commit .env to GitHub.

# --- PostgreSQL (Docker Compose uses these to create the database) ---
POSTGRES_DB=hpms
POSTGRES_USER=hpms
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432
# Used by the backend / scripts when running WITHOUT Docker (Docker Compose builds its own URL):
DATABASE_URL=postgresql://hpms:change-me-db-password@localhost:5432/hpms

# --- Flask ---
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false        # set true when served over HTTPS
DASHBOARD_POLL_SECONDS=5
APP_PORT=5000
HOSPITAL_TZ=Asia/Dili
# full | patients_only | none  — what the backend container imports into an EMPTY database
AUTO_IMPORT=full

# --- Initial application users (min. 8 chars, letters + numbers) ---
ADMIN_PASSWORD=change-me-Admin1
CLINICIAN_PASSWORD=change-me-Clinician1
VIEWER_PASSWORD=change-me-Viewer1

# --- Kafka / Spark ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_TOPIC=patient-vital-events
